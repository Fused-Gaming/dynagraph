{
  "name": "@h4shed/dynagraph",
  "version": "0.1.0",
  "description": "Vector-first dynamic Open Graph image renderer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "open-graph",
    "og-image",
    "renderer",
    "svg",
    "dynamic",
    "image-generation"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fused-Gaming/dynagraph.git"
  },
  "bugs": {
    "url": "https://github.com/Fused-Gaming/dynagraph/issues"
  },
  "homepage": "https://github.com/Fused-Gaming/dynagraph"
}
