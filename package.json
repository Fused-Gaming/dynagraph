{
  "name": "@h4shed/dynagraph",
  "version": "0.2.0",
  "description": "Vector-first dynamic Open Graph image renderer — Phase 7 core rendering engine",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "echo 'No tests yet'",
    "typecheck": "tsc --noEmit",
    "benchmark": "ts-node benchmarks/compare.ts",
    "benchmark:baseline": "npm run benchmark -- --save",
    "benchmark:watch": "npm run benchmark -- --watch",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release:prepare": "npm run build && npm run typecheck && npm run benchmark",
    "release:version": "changeset version",
    "release:publish": "changeset publish && npm publish",
    "release": "npm run release:prepare && npm run release:version && npm run release:publish"
  },
  "keywords": [
    "open-graph",
    "og-image",
    "renderer",
    "svg",
    "dynamic",
    "image-generation",
    "dynagraph"
  ],
  "author": "Fused Gaming",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@h4shed/mcp-core": "^1.0.24"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@h4shed/benchmark-utils": "^2.0.6",
    "@types/node": "^20.12.0",
    "typescript": "^5.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fused-Gaming/dynagraph.git"
  },
  "bugs": {
    "url": "https://github.com/Fused-Gaming/dynagraph/issues"
  },
  "homepage": "https://github.com/Fused-Gaming/dynagraph",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
